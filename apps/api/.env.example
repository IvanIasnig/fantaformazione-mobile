NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Valori dello stack Supabase locale (`pnpm db:start`, poi `pnpm db:status` per rivederli).
# Runtime: in staging/produzione usare l'URL del pooler (Supavisor, transaction mode).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=app"
# Migrazioni e Prisma Studio: connessione diretta. In locale coincide con DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=app"

SUPABASE_URL=http://127.0.0.1:54321
# Gli access token sono firmati con chiavi asimmetriche (ES256) e verificati con il JWKS
# pubblicato da Supabase. Decommentare solo per un progetto che usa ancora il JWT secret legacy (HS256).
# SUPABASE_JWT_SECRET=
