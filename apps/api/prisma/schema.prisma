generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La connessione è in prisma.config.ts (CLI) e in PrismaService (runtime).
// Le tabelle vivono nello schema `app` (vedi ?schema=app negli URL): non è esposto
// dalla Data API di Supabase, quindi il mobile non può interrogarle direttamente.
datasource db {
  provider = "postgresql"
}

/// Dati di dominio dell'utente. L'id coincide con auth.users.id di Supabase:
/// l'identità (email, password, sessioni) resta in Supabase Auth.
model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  timezone    String   @default("Europe/Rome")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}
