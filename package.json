{
  "name": "fanta-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mobile": "pnpm --dir apps/mobile start",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:lint": "pnpm --dir apps/mobile lint",
    "api": "pnpm --dir apps/api dev",
    "api:build": "pnpm --dir apps/api build",
    "api:test": "pnpm --dir apps/api test",
    "api:lint": "pnpm --dir apps/api lint",
    "api:typecheck": "pnpm --dir apps/api typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "pnpm --dir apps/api db:migrate",
    "db:reset": "pnpm --dir apps/api db:reset",
    "db:studio": "pnpm --dir apps/api db:studio"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}
